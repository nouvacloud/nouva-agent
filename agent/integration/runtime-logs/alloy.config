discovery.docker "runtime_logs" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "1s"
}

discovery.relabel "runtime_logs" {
  targets = discovery.docker.runtime_logs.targets

  rule {
    source_labels = ["__meta_docker_container_label_nouva_runtime_log_test"]
    action        = "keep"
    regex         = "true"
  }

  rule {
    source_labels = ["__meta_docker_container_label_nouva_runtime_log_run"]
    target_label  = "test_run"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
    regex         = "/(.*)"
  }
}

loki.source.docker "runtime_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.runtime_logs.output
  forward_to       = [loki.write.runtime_logs.receiver]
  refresh_interval = "1s"
}

loki.write "runtime_logs" {
  endpoint {
    url       = "http://toxiproxy:8666/loki/api/v1/push"
    tenant_id = "runtime-log-test"

    remote_timeout        = "10s"
    min_backoff_period    = "1s"
    max_backoff_period    = "1m"
    max_backoff_retries   = 1200
    retry_on_http_429     = true

    queue_config {
      capacity          = "64MiB"
      min_shards        = 1
      block_on_overflow = true
      drain_timeout     = "1m"
    }
  }

  wal {
    enabled         = true
    max_segment_age = "24h"
    drain_timeout   = "1m"
  }
}
